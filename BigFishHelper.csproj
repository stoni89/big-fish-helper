<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.2.0.0</Version>
    <!-- Manifest-Felder (siehe https://github.com/goatcorp/DalamudPackager) -->
    <Author>Stoni</Author>
    <Name>Big Fish Helper</Name>
    <Punchline>Helper for catching Big Fish</Punchline>
    <Description>Helps you catch Big Fish, working together with AutoHook.</Description>
    <RepoUrl>https://github.com/stoni89/big-fish-helper</RepoUrl>
    <Tags>fishing;bigfish;utility;bigfishhelper</Tags>
    <!-- Icon im Dalamud-Plugin-Installer (Dev Plugins-Liste) statt Platzhalter - wird als URL geladen, deshalb der rohe GitHub-Link statt eines lokalen Pfads. -->
    <IconUrl>https://raw.githubusercontent.com/stoni89/big-fish-helper/main/Data/icon.png</IconUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Data\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Angel-Positionen aller Big Fish - wird mit ausgeliefert (siehe FishingPositionStore). -->
    <None Include="Data\FishingPositions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.2.1.21" />
  </ItemGroup>
</Project>
