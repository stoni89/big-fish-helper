<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.7.0.0</Version>
    <!-- Manifest-Felder (siehe https://github.com/goatcorp/DalamudPackager) -->
    <Author>Stoni</Author>
    <Name>Big Fish Helper</Name>
    <Punchline>Helper for catching Big Fish</Punchline>
    <Description>Helps you catch Big Fish, working together with AutoHook.</Description>
    <RepoUrl>https://github.com/stoni89/big-fish-helper</RepoUrl>
    <Tags>fishing;bigfish;utility;bigfishhelper</Tags>
    <!-- Icon im Dalamud-Plugin-Installer (Dev Plugins-Liste) statt Platzhalter - wird als URL geladen, deshalb der rohe GitHub-Link statt eines lokalen Pfads. -->
    <IconUrl>https://raw.githubusercontent.com/stoni89/big-fish-helper/main/Data/icon.png</IconUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Data\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Angel-Positionen aller Big Fish - wird mit ausgeliefert (siehe FishingPositionStore). -->
    <None Include="Data\FishingPositions.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Änderungsprotokoll-Einträge für die Changelog-Seite (siehe ChangelogService). -->
    <None Include="Data\Changelog.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Eigene Kopien der PluginUiKit-Schriften - UiFonts.FontPath löst relativ zum AssemblyLocation
         DES AUFRUFENDEN Plugins auf, jedes Plugin braucht daher seine eigenen .ttf-Dateien. -->
    <None Include="Data\Fonts\Cinzel.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\Cinzel-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\AlegreyaItalic.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\AlegreyaSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\AlegreyaSans-Medium.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\AlegreyaSans-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\OFL-Cinzel.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\OFL-AlegreyaSans.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\OFL-Alegreya.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Das Submodule unter external/PluginUiKit ist ein EIGENES Projekt (siehe ProjectReference
         weiter unten), kein Teil dieses Projekts - ohne diesen Ausschluss greift der SDK-Standard-
         Glob "**/*.cs" trotzdem zu, da das Submodule INNERHALB dieses Projektordners liegt, und
         kompiliert jede Datei doppelt (einmal direkt hier, einmal über die referenzierte
         PluginUiKit.dll) - "conflicts with the imported type"-Warnungen plus Duplicate-Attribute-
         Fehler aus den doppelten obj/-Dateien (1:1 derselbe Fix wie TheExplorersCodex.csproj). -->
    <Compile Remove="external\**\*.cs" />
    <None Remove="external\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.2.1.21" />
    <!-- Eigenes Repo (github.com/stoni89/plugin-ui-kit, auch von TheExplorersCodex genutzt), hier als
         Git-Submodule eingebunden (siehe .gitmodules) statt eines Sibling-Ordners außerhalb dieses
         Repos - ein Projektverweis nach "..\" liegt außerhalb des Checkouts und war in GitHub Actions
         nicht auflösbar (Build schlug dort fehl, lokal unbemerkt, da der Sibling-Ordner dort
         existierte). .github/workflows/release.yml checkt das Submodule deshalb jetzt mit aus
         (submodules: true). -->
    <ProjectReference Include="external\PluginUiKit\PluginUiKit.csproj" />
  </ItemGroup>
</Project>
